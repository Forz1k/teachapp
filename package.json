{
  "name": "teachapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Электронный журнал учителя физической культуры — офлайн PWA на чистом HTML/CSS/JS",
  "scripts": {
    "start": "python -m http.server 8099 --bind 127.0.0.1",
    "serve": "python -m http.server 8099 --bind 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/validate.mjs",
    "snapshot": "node tools/prepare-snapshot.mjs",
    "shots": "node tools/shot.mjs",
    "offline": "node tools/offline-verify.mjs --clean",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0"
  }
}
