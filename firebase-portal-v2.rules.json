                },
                "b": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
                },
                "date": {
                  ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
                },
                "time": {
                  ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^([01][0-9]|2[0-3]):[0-5][0-9]$/))"
                },
                "venue": {
                  ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
                },
                "status": {
                  ".validate": "newData.isString() && (newData.val() === 'finished' || newData.val() === 'scheduled' || newData.val() === 'waiting')"
                },
                "score": {
                  ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}:[0-9]{1,3}$/)"
                },
                "$other": {
                  ".validate": "false"
