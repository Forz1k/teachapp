                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "group": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2 && newData.val() % 1 === 0"
                },
                "played": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "won": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "draw": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "lost": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "points": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0"
                },
                "$other": {
                  ".validate": "false"
                }
              }
            },
            "games": {
              "$i": {
                ".validate": "$i.matches(/^(0|[1-9][0-9]?|[1-4][0-9][0-9])$/) && newData.hasChildren(['round','group','a','b','date','time','venue','status']) && ((newData.child('status').val() === 'finished' && newData.hasChild('score')) || (newData.child('status').val() !== 'finished' && !newData.hasChild('score')))",
                "round": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 32 && newData.val() % 1 === 0"
                },
                "group": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2 && newData.val() % 1 === 0"
                },
                "a": {
